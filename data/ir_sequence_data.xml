<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_adk_reception_visit" model="ir.sequence">
        <field name="name">ADK Réception - Visite</field>
        <field name="code">adk.reception.visit</field>
        <field name="prefix">V%(year)s%(month)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_adk_reception_goods" model="ir.sequence">
        <field name="name">ADK Réception - Biens &amp; Marchandises</field>
        <field name="code">adk.reception.goods</field>
        <field name="prefix">COL%(year)s%(month)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
