<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_visit_badge_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center" style="border:3px solid #2c3e50;border-radius:12px;padding:24px;max-width:420px;margin:0 auto;">
                            <h2 style="color:#2c3e50;margin-bottom:0;">BADGE VISITEUR</h2>
                            <p class="text-muted" style="margin-top:4px;"><span t-field="o.name"/></p>
                            <div style="margin:16px 0;">
                                <img t-if="o.photo" t-att-src="image_data_uri(o.photo)"
                                     style="width:120px;height:120px;object-fit:cover;border-radius:50%;border:2px solid #2c3e50;"/>
                            </div>
                            <table class="table table-sm" style="width:100%;text-align:left;">
                                <tr>
                                    <td style="font-weight:bold;padding:4px 0;width:35%;">Nom :</td>
                                    <td><span t-field="o.visitor_name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold;padding:4px 0;">Entreprise :</td>
                                    <td><t t-esc="o.visitor_company or '-'"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold;padding:4px 0;">Hôte :</td>
                                    <td><span t-field="o.host_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold;padding:4px 0;">Motif :</td>
                                    <td><t t-esc="o.motif_id.name or o.motif_detail or '-'"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold;padding:4px 0;">Entrée :</td>
                                    <td><span t-if="o.check_in_datetime" t-field="o.check_in_datetime"/><t t-else="">-</t></td>
                                </tr>
                                <tr t-if="o.badge_number">
                                    <td style="font-weight:bold;padding:4px 0;">N° Badge :</td>
                                    <td><span t-field="o.badge_number"/></td>
                                </tr>
                            </table>
                            <p class="text-muted" style="font-size:11px;margin-top:16px;">
                                Ce badge doit être visible en permanence et restitué à l'accueil en fin de visite.
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
