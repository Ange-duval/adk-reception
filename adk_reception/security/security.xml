<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_adk_reception" model="ir.module.category">
        <field name="name">ADK Réception</field>
        <field name="sequence">15</field>
    </record>

    <record id="group_reception_user" model="res.groups">
        <field name="name">Agent d'accueil</field>
        <field name="category_id" ref="module_category_adk_reception"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_reception_manager" model="res.groups">
        <field name="name">Responsable Réception / Sécurité</field>
        <field name="category_id" ref="module_category_adk_reception"/>
        <field name="implied_ids" eval="[(4, ref('group_reception_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_reception_visit_company" model="ir.rule">
        <field name="name">ADK Réception : Visites (multi-sociétés)</field>
        <field name="model_id" ref="model_adk_reception_visit"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_reception_employee_movement_company" model="ir.rule">
        <field name="name">ADK Réception : Badgeages employés (multi-sociétés)</field>
        <field name="model_id" ref="model_adk_reception_employee_movement"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_reception_goods_company" model="ir.rule">
        <field name="name">ADK Réception : Biens &amp; marchandises (multi-sociétés)</field>
        <field name="model_id" ref="model_adk_reception_goods"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
