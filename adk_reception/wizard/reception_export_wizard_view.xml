<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reception_export_wizard_form" model="ir.ui.view">
        <field name="name">adk.reception.export.wizard.form</field>
        <field name="model">adk.reception.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Générateur d'export">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="profile_type" widget="radio"/>
                        <field name="export_format" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export" string="Générer l'export" type="object"
                            class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reception_export_wizard" model="ir.actions.act_window">
        <field name="name">Générateur d'export</field>
        <field name="res_model">adk.reception.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_reception_security_list_wizard_form" model="ir.ui.view">
        <field name="name">adk.reception.security.list.wizard.form</field>
        <field name="model">adk.reception.security.list.wizard</field>
        <field name="arch" type="xml">
            <form string="Liste de sécurité - Personnes présentes">
                <p class="text-muted">
                    Cette liste recense en temps réel toutes les personnes (visiteurs et employés)
                    actuellement présentes sur site. À utiliser en priorité lors d'une évacuation.
                </p>
                <footer>
                    <button name="action_print" string="Imprimer la liste" type="object"
                            class="btn-primary"/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reception_security_list_wizard" model="ir.actions.act_window">
        <field name="name">Liste des Présents (Sécurité)</field>
        <field name="res_model">adk.reception.security.list.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
