<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_reception_goods" model="ir.actions.act_window">
        <field name="name">Biens &amp; Marchandises</field>
        <field name="res_model">adk.reception.goods</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enregistrez le premier mouvement</p>
            <p>Colis, livraisons, fournitures et équipements : suivez chaque entrée/sortie et
               distinguez les flux temporaires (réparation) des flux définitifs.</p>
        </field>
    </record>

    <record id="view_reception_goods_list" model="ir.ui.view">
        <field name="name">adk.reception.goods.list</field>
        <field name="model">adk.reception.goods</field>
        <field name="arch" type="xml">
            <list decoration-info="direction == 'in'" decoration-muted="direction == 'out'">
                <field name="name"/>
                <field name="description"/>
                <field name="goods_type"/>
                <field name="direction"/>
                <field name="quantity"/>
                <field name="partner_id"/>
                <field name="recipient_employee_id"/>
                <field name="movement_datetime"/>
                <field name="status"/>
                <field name="state" widget="badge" decoration-success="state == 'processed'"
                       decoration-info="state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_reception_goods_form" model="ir.ui.view">
        <field name="name">adk.reception.goods.form</field>
        <field name="model">adk.reception.goods</field>
        <field name="arch" type="xml">
            <form string="Bien / Marchandise">
                <header>
                    <button name="action_mark_processed" string="Marquer Traité" type="object"
                            class="oe_highlight" invisible="state == 'processed'"/>
                    <button name="action_mark_returned" string="Marquer Retourné" type="object"
                            invisible="status != 'temporary' or state == 'returned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,processed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="description" string="Désignation"/>
                        <h1><field name="description" placeholder="ex: Colis DHL - Pièces détachées"/></h1>
                    </div>
                    <group>
                        <group string="Flux">
                            <field name="goods_type" options="{'no_create': False, 'no_open': False}"/>
                            <field name="direction"/>
                            <field name="quantity"/>
                            <field name="status"/>
                            <field name="expected_return_date" invisible="status != 'temporary'"/>
                        </group>
                        <group string="Traçabilité">
                            <field name="partner_id" options="{'no_create': False, 'no_open': False}"/>
                            <field name="recipient_employee_id" options="{'no_create': False, 'no_open': False}"/>
                            <field name="reference_doc"/>
                            <field name="movement_datetime"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Observations">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_reception_goods_search" model="ir.ui.view">
        <field name="name">adk.reception.goods.search</field>
        <field name="model">adk.reception.goods</field>
        <field name="arch" type="xml">
            <search>
                <field name="description"/>
                <field name="partner_id"/>
                <field name="recipient_employee_id"/>
                <filter string="Aujourd'hui" name="today"
                        domain="[('movement_datetime', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <separator/>
                <filter string="Entrées" name="in" domain="[('direction', '=', 'in')]"/>
                <filter string="Sorties" name="out" domain="[('direction', '=', 'out')]"/>
                <filter string="Temporaire" name="temporary" domain="[('status', '=', 'temporary')]"/>
                <filter string="En attente" name="pending" domain="[('state', '=', 'pending')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Type" name="group_type" context="{'group_by': 'goods_type'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'movement_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
