<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_reception_employee_movement" model="ir.actions.act_window">
        <field name="name">Badgeage Employés</field>
        <field name="res_model">adk.reception.employee.movement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enregistrez le premier badgeage</p>
            <p>Pointage par QR Code, NFC ou matricule, avec détection automatique des retards
               et heures supplémentaires.</p>
        </field>
    </record>

    <record id="view_reception_employee_movement_list" model="ir.ui.view">
        <field name="name">adk.reception.employee.movement.list</field>
        <field name="model">adk.reception.employee.movement</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_late" decoration-warning="is_overtime"
                  decoration-success="state == 'present' and not is_late">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="badge_method"/>
                <field name="check_in_datetime"/>
                <field name="check_out_datetime"/>
                <field name="duration" widget="float_time"/>
                <field name="anomaly_notes"/>
                <field name="state" widget="badge" decoration-success="state == 'present'"/>
                <button name="action_check_out" string="Check-out" type="object" icon="fa-sign-out"
                        invisible="state != 'present'"/>
            </list>
        </field>
    </record>

    <record id="view_reception_employee_movement_form" model="ir.ui.view">
        <field name="name">adk.reception.employee.movement.form</field>
        <field name="model">adk.reception.employee.movement</field>
        <field name="arch" type="xml">
            <form string="Badgeage Employé">
                <header>
                    <button name="action_check_in" string="✅ Check-in" type="object" class="oe_highlight"
                            invisible="state != 'left'"/>
                    <button name="action_check_out" string="🚪 Check-out" type="object" class="oe_highlight"
                            invisible="state != 'present'"/>
                    <field name="state" widget="statusbar" statusbar_visible="present,left"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not is_late">
                        <i class="fa fa-exclamation-triangle"/> Retard détecté à l'entrée.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not is_overtime">
                        <i class="fa fa-clock-o"/> Heures supplémentaires détectées à la sortie.
                    </div>
                    <group>
                        <group string="Employé">
                            <field name="employee_id" options="{'no_create': False, 'no_open': False}"/>
                            <field name="department_id" readonly="1"/>
                            <field name="matricule" readonly="1"/>
                            <field name="badge_method" options="{'no_create': False, 'no_open': False}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Horodatage">
                            <field name="check_in_datetime"/>
                            <field name="check_out_datetime"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                    <group string="Anomalies détectées">
                        <field name="is_late" readonly="1"/>
                        <field name="late_minutes" readonly="1" invisible="not is_late"/>
                        <field name="is_overtime" readonly="1"/>
                        <field name="overtime_minutes" readonly="1" invisible="not is_overtime"/>
                    </group>
                    <notebook>
                        <page string="Matériel de travail" name="material">
                            <field name="material_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="category" options="{'no_create': False, 'no_open': False}"/>
                                    <field name="quantity"/>
                                    <field name="direction"/>
                                    <field name="returned" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_reception_employee_movement_search" model="ir.ui.view">
        <field name="name">adk.reception.employee.movement.search</field>
        <field name="model">adk.reception.employee.movement</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter string="Aujourd'hui" name="today"
                        domain="[('check_in_datetime', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <separator/>
                <filter string="Présents" name="present" domain="[('state', '=', 'present')]"/>
                <filter string="Retards" name="late" domain="[('is_late', '=', True)]"/>
                <filter string="Heures sup." name="overtime" domain="[('is_overtime', '=', True)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Département" name="group_dept" context="{'group_by': 'department_id'}"/>
                    <filter string="Employé" name="group_emp" context="{'group_by': 'employee_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'check_in_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
