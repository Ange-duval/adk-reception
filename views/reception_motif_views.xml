<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_reception_motif" model="ir.actions.act_window">
        <field name="name">Motifs de Visite</field>
        <field name="res_model">adk.reception.motif</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_reception_motif_list" model="ir.ui.view">
        <field name="name">adk.reception.motif.list</field>
        <field name="model">adk.reception.motif</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
</odoo>
